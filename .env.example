# Copy to .env (gitignored). The launchclip CLI reads .env from the working
# directory and from a project command's directory at startup; variables that
# are already set in your shell always win.

# ElevenLabs: opt-in narration (launchclip finish --voice elevenlabs) and music
# (launchclip finish --music elevenlabs, the default when this key is set).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MUSIC_MODEL=music_v1

# Model providers for the production lane.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Cache for downloaded models and generated music (default ~/.cache/launchclip).
# LAUNCHCLIP_CACHE=
