# Copy to .env (gitignored). The launchclip CLI reads .env from the working
# directory and from a project command's directory at startup; variables that
# are already set in your shell always win.

# ElevenLabs: opt-in narration (launchclip finish --voice elevenlabs) and music
# (launchclip finish --music elevenlabs, the default when this key is set).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MUSIC_MODEL=music_v1

# Generated footage (opt-in: make/finish --generate, docs/guide/generated-footage.md).
# Nothing is generated or paid for without a --generate flag; every run quotes first.
# fal.ai, for --generate fal:<model>.
FAL_KEY=
# ElevenLabs image and video (--generate elevenlabs:<model>) uses ELEVENLABS_API_KEY above;
# it reports no cost, so it also needs --max-generations.
# A local ComfyUI server for --generate local:<workflow.json> (default http://127.0.0.1:8188).
# COMFYUI_URL=

# Model providers for the production lane.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# The model make uses for every call (script, plan, critic, keyframe judge);
# overrides the OPENAI/ANTHROPIC defaults. The keyframe judge needs one that takes images.
# LAUNCHCLIP_MAKE_MODEL=openrouter:openai/gpt-5.6-luna

# Cache for downloaded models and generated music (default ~/.cache/launchclip).
# LAUNCHCLIP_CACHE=
