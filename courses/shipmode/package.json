{
  "name": "launchclip-shipmode-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "hyperframes doctor --json",
    "dev": "hyperframes preview finished",
    "dev:starter": "hyperframes preview starter",
    "check": "hyperframes check finished --strict --samples 17 --at-transitions",
    "check:starter": "hyperframes check starter --strict --samples 17 --at-transitions",
    "snapshot": "hyperframes snapshot finished --at 0,1,3,5,7.9",
    "render": "hyperframes render finished --quality draft --fps 30 --workers 1 --strict-all --output finished/renders/shipmode.mp4",
    "render:starter": "hyperframes render starter --quality draft --fps 30 --workers 1 --strict-all --output starter/renders/shipmode.mp4"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.7.58"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.4"
  }
}
