{
  "name": "launchclip",
  "version": "0.1.1",
  "description": "Create reviewable launch videos and OSS promotion packets from local product evidence.",
  "type": "module",
  "bin": {
    "launchclip": "bin/launchclip.js"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node ./scripts/smoke.js",
    "check": "npm test && npm run smoke",
    "eval:production": "node ./src/production_eval.js",
    "package:smoke": "node ./scripts/package-smoke.js",
    "release:check": "npm run check && npm run package:smoke",
    "skills:sync": "node ./scripts/sync-skills.mjs",
    "skills:check": "node ./scripts/sync-skills.mjs --check"
  },
  "keywords": [
    "oss",
    "promotion",
    "video",
    "captions",
    "cli",
    "hyperframes",
    "remotion",
    "product-videogen",
    "agent-skills"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/launchclip.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    ".codex-plugin",
    "bin",
    "examples/motion/golden-timeline.json",
    "examples/hyperframes-local",
    "kit",
    "motion-engine",
    "public/base/README.md",
    "public/icons",
    "public/shots",
    "remotion",
    "src",
    "docs",
    "skills",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/motion-blur": "4.0.536",
    "@remotion/three": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "hyperframes": "0.7.58",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "three": "0.184.0"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/launchclip/issues"
  },
  "homepage": "https://github.com/rogerchappel/launchclip#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "gsap": "^3.14.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "kokoro-js": "1.2.1"
  }
}
