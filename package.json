{
  "name": "launchclip",
  "version": "0.2.0",
  "description": "Describe your video, drop in your stuff, get the finished video: launch videos, product demos and edits from one prompt, with your AI agent or headless.",
  "type": "module",
  "bin": {
    "launchclip": "bin/launchclip.js"
  },
  "scripts": {
    "test": "node ./scripts/test.mjs",
    "test:media": "node ./scripts/media-tests.mjs",
    "test:all": "LAUNCHCLIP_MEDIA_TESTS=1 node ./scripts/test.mjs",
    "smoke": "node ./scripts/smoke.js",
    "check": "npm test && npm run typecheck && npm run smoke",
    "typecheck": "tsc -p tsconfig.json",
    "parity:ci": "node ./scripts/parity-ci.mjs",
    "eval:production": "node ./src/production_eval.js",
    "eval:renderers": "node ./src/renderer_eval.js",
    "eval:formats": "node ./eval/formats.mjs",
    "package:smoke": "node ./scripts/package-smoke.js",
    "release:check": "npm run check && npm run package:smoke",
    "skills:sync": "node ./scripts/sync-skills.mjs",
    "skills:check": "node ./scripts/sync-skills.mjs --check"
  },
  "keywords": [
    "video",
    "launch-video",
    "product-demo",
    "saas",
    "motion-graphics",
    "captions",
    "video-editing",
    "remotion",
    "hyperframes",
    "agent-skills",
    "claude-code",
    "codex",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/launchclip.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "kit/core"
  ],
  "files": [
    ".codex-plugin",
    "bin",
    "examples/motion/golden-timeline.json",
    "examples/hyperframes-local",
    "kit",
    "motion-engine",
    "public/base/README.md",
    "public/icons",
    "public/shots",
    "remotion",
    "src",
    "docs",
    "skills",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/stix-two-text": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/stix-two-math": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@launchclip/core": "0.2.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/motion-blur": "4.0.536",
    "@remotion/three": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "hyperframes": "0.7.58",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "three": "0.184.0"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/launchclip/issues"
  },
  "homepage": "https://github.com/rogerchappel/launchclip#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "0.28.1",
    "gsap": "^3.14.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "gpt-tokenizer": "3.4.0",
    "kokoro-js": "1.2.1",
    "onnxruntime-node": "1.27.0",
    "playwright": "1.64.1"
  }
}
