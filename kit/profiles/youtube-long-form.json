{
  "schema": "launchclip.cadence-profile.v1",
  "id": "youtube-long-form",
  "title": "YouTube long form",
  "description": "A presenter-led video of 5–30 minutes in 16:9, structured in chapters.",
  "format": "footage-led",
  "match": {
    "lanes": [
      "footage-led"
    ],
    "aspects": [
      "16:9",
      "1:1"
    ],
    "platforms": [
      "youtube"
    ]
  },
  "duration_seconds": [
    300,
    1800
  ],
  "references": 0,
  "provenance": {
    "kind": "seed",
    "note": "Seed ranges, not measured: set conservatively wide from the RFC placeholders and the current gate floors until a reference set is measured with launchclip profile measure. Treat the bands as guard rails, not targets to tune to.",
    "sources": []
  },
  "measures": {
    "shot_seconds": {
      "p10": 1.5,
      "p50": 5,
      "p90": 15
    },
    "visual_changes_per_min": {
      "p10": 4,
      "p50": 10,
      "p90": 24
    },
    "coverage": {
      "p10": 0.25,
      "p50": 0.48,
      "p90": 0.8
    },
    "face_time": {
      "p10": 0.5,
      "p50": 0.8,
      "p90": 0.97
    },
    "longest_undressed_seconds": {
      "p50": 14,
      "p90": 30
    },
    "first_visual_seconds": {
      "p50": 0.5,
      "p90": 3
    },
    "text_hold_seconds": {
      "p10": 1.2,
      "p50": 3,
      "p90": 8
    },
    "caption_words_on_screen": {
      "p50": 3,
      "p90": 7
    },
    "layout_changes_per_min": {
      "p50": 1.5,
      "p90": 4
    },
    "subject_effect_share": {
      "p50": 0.1,
      "p90": 0.3
    },
    "flow_velocity_p90": {
      "p10": 0,
      "p50": 1.1,
      "p90": 6
    },
    "hold_ratio": {
      "p90": 0.995
    },
    "motion_bursts_per_min": {
      "p10": 0
    },
    "change_energy_p50": {
      "p10": 0
    },
    "first_motion_seconds": {
      "p90": 3
    },
    "hook_events": {
      "p10": 1
    }
  }
}
