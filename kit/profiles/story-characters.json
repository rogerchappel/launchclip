{
  "schema": "launchclip.cadence-profile.v1",
  "id": "story-characters",
  "title": "Story with characters",
  "description": "A fully animated story told by a cast (setup, problem, attempt, turn, resolution), 30 s to 3 minutes, 16:9 or 9:16.",
  "format": "characters",
  "match": {
    "lanes": [
      "motion",
      "voiceover-motion"
    ],
    "aspects": [
      "16:9",
      "9:16"
    ],
    "cast": true
  },
  "duration_seconds": [
    20,
    180
  ],
  "references": 0,
  "provenance": {
    "kind": "seed",
    "note": "Seed ranges, not measured: set conservatively wide from the RFC placeholders and the current gate floors until a reference set is measured with launchclip profile measure. Treat the bands as guard rails, not targets to tune to.",
    "sources": []
  },
  "measures": {
    "scene_seconds": {
      "p10": 1.5,
      "p50": 4,
      "p90": 9
    },
    "visual_changes_per_min": {
      "p10": 8,
      "p50": 18,
      "p90": 40
    },
    "coverage": {
      "p10": 0.9,
      "p50": 1,
      "p90": 1
    },
    "longest_undressed_seconds": {
      "p50": 0,
      "p90": 1
    },
    "first_visual_seconds": {
      "p50": 0,
      "p90": 0.5
    },
    "character_screen_time": {
      "p10": 0.4,
      "p50": 0.7,
      "p90": 0.95
    },
    "expression_changes_per_min": {
      "p10": 3,
      "p50": 8,
      "p90": 20
    },
    "problem_lands_seconds": {
      "p50": 5,
      "p90": 12
    },
    "caption_words_on_screen": {
      "p50": 3,
      "p90": 6
    },
    "flow_velocity_p90": {
      "p10": 2
    },
    "hold_ratio": {
      "p90": 0.8
    },
    "motion_bursts_per_min": {
      "p10": 20
    },
    "change_energy_p50": {
      "p10": 0.35
    },
    "first_motion_seconds": {
      "p90": 0.35
    },
    "hook_events": {
      "p10": 3
    }
  }
}
