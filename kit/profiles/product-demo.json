{
  "schema": "launchclip.cadence-profile.v1",
  "id": "product-demo",
  "title": "Product demo",
  "description": "A video led by recorded product flows (product-demo scenes), 30 s to 2 minutes, any aspect.",
  "format": "demo-led",
  "match": {
    "lanes": [
      "motion",
      "voiceover-motion"
    ],
    "demo": true
  },
  "duration_seconds": [
    20,
    120
  ],
  "references": 0,
  "provenance": {
    "kind": "seed",
    "note": "Seed ranges, not measured: set conservatively wide from the RFC placeholders and the current gate floors until a reference set is measured with launchclip profile measure. Treat the bands as guard rails, not targets to tune to.",
    "sources": []
  },
  "measures": {
    "shot_seconds": {
      "p10": 1.2,
      "p50": 3.5,
      "p90": 10
    },
    "visual_changes_per_min": {
      "p10": 4,
      "p50": 16,
      "p90": 36
    },
    "coverage": {
      "p10": 0.9,
      "p50": 1,
      "p90": 1
    },
    "longest_undressed_seconds": {
      "p50": 0,
      "p90": 1
    },
    "first_visual_seconds": {
      "p50": 0,
      "p90": 0.5
    },
    "text_hold_seconds": {
      "p10": 1,
      "p50": 3,
      "p90": 10
    },
    "caption_words_on_screen": {
      "p50": 3,
      "p90": 7
    },
    "flow_velocity_p90": {
      "p10": 2
    },
    "hold_ratio": {
      "p90": 0.8
    },
    "motion_bursts_per_min": {
      "p10": 20
    },
    "change_energy_p50": {
      "p10": 0.35
    },
    "first_motion_seconds": {
      "p90": 0.35
    },
    "hook_events": {
      "p10": 3
    }
  }
}
