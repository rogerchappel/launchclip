      "p50": 28,
      "p90": 60
    },
    "coverage": {
      "p10": 0.9,
      "p50": 1,
      "p90": 1
    },
    "longest_undressed_seconds": {
      "p50": 0,
      "p90": 1
    },
    "first_visual_seconds": {
      "p50": 0,
      "p90": 0.5
    },
    "text_hold_seconds": {
      "p10": 0.8,
      "p50": 2.2,
      "p90": 6
    },
    "caption_words_on_screen": {
      "p50": 3,
      "p90": 6
    },
    "flow_velocity_p90": {
      "p10": 2
    },
    "hold_ratio": {
      "p90": 0.8
    },
    "motion_bursts_per_min": {
      "p10": 20
    },
    "change_energy_p50": {
      "p10": 0.35
    },
    "first_motion_seconds": {
      "p90": 0.35
    },
    "hook_events": {
      "p10": 3
    }
  }
