{
  "schema": "launchclip.cadence-profile.v1",
  "id": "short-motion",
  "title": "Short motion",
  "description": "Motion graphics (with or without a voiceover) for Shorts, Reels and TikTok.",
  "format": "motion",
  "match": {
    "lanes": [
      "motion",
      "voiceover-motion"
    ],
    "aspects": [
      "9:16"
    ],
    "platforms": [
      "youtube-shorts",
      "instagram-reels",
      "tiktok"
    ]
  },
  "duration_seconds": [
    5,
    60
  ],
  "references": 0,
  "provenance": {
    "kind": "seed",
    "note": "Seed ranges, not measured: set conservatively wide from the RFC placeholders and the current gate floors until a reference set is measured with launchclip profile measure. Treat the bands as guard rails, not targets to tune to. The pace fields (hook_rate_ratio, max_event_gap_seconds, cuts_on_beat_ratio) are the pace table of docs/PLAN_AND_PACE_RFC.md §2 for this format.",
    "sources": []
  },
  "measures": {
    "shot_seconds": {
      "p10": 0.8,
      "p50": 2,
      "p90": 8
    },
    "visual_changes_per_min": {
      "p10": 6,
      "p50": 28,
      "p90": 60
    },
    "coverage": {
      "p10": 0.9,
      "p50": 1,
      "p90": 1
    },
    "longest_undressed_seconds": {
      "p50": 0,
      "p90": 1
    },
    "first_visual_seconds": {
      "p50": 0,
      "p90": 0.5
    },
    "text_hold_seconds": {
      "p10": 0.8,
      "p50": 2.2,
      "p90": 6
    },
    "caption_words_on_screen": {
      "p50": 3,
      "p90": 6
    },
    "flow_velocity_p90": {
      "p10": 2
    },
    "hold_ratio": {
      "p90": 0.8
    },
    "motion_bursts_per_min": {
      "p10": 20
    },
    "change_energy_p50": {
      "p10": 0.35
    },
    "first_motion_seconds": {
      "p90": 0.35
    },
    "hook_events": {
      "p10": 3
    },
    "hook_rate_ratio": {
      "p10": 1.3
    },
    "max_event_gap_seconds": {
      "p90": 2.5
    },
    "cuts_on_beat_ratio": {
      "p10": 0.6
    }
  }
}
