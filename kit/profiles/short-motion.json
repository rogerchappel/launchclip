{
  "schema": "launchclip.cadence-profile.v1",
  "id": "short-motion",
  "title": "Short motion",
  "description": "Motion graphics (with or without a voiceover) for Shorts, Reels and TikTok.",
  "format": "motion",
  "match": {
    "lanes": [
      "motion",
      "voiceover-motion"
    ],
    "aspects": [
      "9:16"
    ],
    "platforms": [
      "youtube-shorts",
      "instagram-reels",
      "tiktok"
    ]
  },
  "duration_seconds": [
    5,
    60
  ],
  "references": 0,
  "provenance": {
    "kind": "seed",
    "note": "Seed ranges, not measured: set conservatively wide from the RFC placeholders and the current gate floors until a reference set is measured with launchclip profile measure. Treat the bands as guard rails, not targets to tune to.",
    "sources": []
  },
  "measures": {
    "shot_seconds": {
      "p10": 0.8,
      "p50": 2,
      "p90": 5
    },
    "visual_changes_per_min": {
