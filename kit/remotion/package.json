{
  "name": "@launchclip/remotion",
  "version": "0.2.0",
  "description": "LaunchClip's Remotion kit: StoryComposition, the module components and registries, captions, brand frame and the bundled fonts, for apps that render launchclip.story.v1 stories in their own Remotion bundle or @remotion/player.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/types/font-files.d.ts",
      "default": "./dist/fonts.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "postpack": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\""
  },
  "keywords": [
    "video",
    "remotion",
    "storyboard",
    "motion-graphics",
    "captions",
    "launchclip"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/launchclip.git",
    "directory": "kit/remotion"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/launchclip/issues"
  },
  "homepage": "https://github.com/rogerchappel/launchclip/tree/main/kit/remotion#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@launchclip/core": "0.2.0",
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/stix-two-text": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/stix-two-math": "5.3.0",
    "@fontsource/young-serif": "5.3.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "^5.9.3"
  }
}
