{
  "schema": "launchclip.style.v3",
  "name": "neon-explainer",
  "description": "Playful science explainers: deep violet night, cyan and magenta neon, a rounded grotesque display face, glowing captions and lively motion.",
  "brand": {
    "colors": {
      "bg": "#07051a",
      "paper": "#f4f1ff",
      "ink": "#07051a",
      "primary": "#19f0ff",
      "accent": "#ff4fd8"
    },
    "fonts": {
      "display": "bricolage-grotesque",
      "body": "space-grotesk",
      "meta": "jetbrains-mono"
    }
  },
  "motion": {
    "grammar": "playful"
  },
  "camera": {
    "mode": "world",
    "layout": "auto"
  },
  "ambient": {
    "level": "lively"
  },
  "captions": {
    "preset": "glow",
    "position": "auto",
    "lanes": {
      "footage-led": {
        "preset": "quiet-accent"
      }
    }
  },
  "sound": {
    "sfx_density": "normal",
    "music": {
      "prompt_hints": [
        "retro synthwave",
        "arpeggiated synths",
        "gated reverb snare"
      ],
      "bpm_range": [
        100,
        118
      ],
      "energy_curve": "build-to-drop"
    }
  },
  "modules": {
    "prefer": [
      "function-chart",
      "gauge-compare",
      "flow-compare",
      "equation-lockup",
      "kinetic-words"
    ],
    "avoid": [
      "excerpt-window"
    ],
    "params": {
      "callout": {
        "presentation": "glass"
      }
    }
  },
  "layout": {
    "title_case": false
  },
  "layouts": {
    "by_intent": {
      "list": "split-left",
      "concept": "insert"
    },
    "by_section": {
      "hook": "full"
    },
    "panel": {
      "treatment": "glass",
      "radius": 36
    }
  },
  "vocabulary": {
    "icon_tint": "accent",
    "illustration": true,
    "prefer": {
      "claim": [
        "kinetic-words",
        "glass-word"
      ],
      "list": [
        "checklist"
      ],
      "concept": [
        "function-chart",
        "equation-lockup"
      ]
    }
  },
  "cast": {
    "drawing_style": "outlined",
    "colors": {
      "fill": "primary",
      "accent": "accent",
      "line": "paper"
    }
  },
  "brand_frame": {
    "enabled": true,
    "kicker": {
      "underline": true,
      "position": "top-left",
      "logo": true
    },
    "sections": true,
    "progress": true,
    "show": "always"
  },
  "dials": {
    "energy": 0.7,
    "density": 0.6,
    "playfulness": 0.8,
    "polish": 0.6
  },
  "loop": true
}
