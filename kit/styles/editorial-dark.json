{
  "schema": "launchclip.style.v3",
  "name": "editorial-dark",
  "description": "Magazine-like explainers: near-black paper, warm gold accents, a literary serif display face, quiet captions and sparse sound.",
  "brand": {
    "colors": {
      "bg": "#0e0f12",
      "paper": "#f1ede4",
      "ink": "#0e0f12",
      "primary": "#e8b04a",
      "accent": "#7fb8a4"
    },
    "fonts": {
      "display": "stix-two-text",
      "body": "inter",
      "meta": "jetbrains-mono"
    }
  },
  "motion": {
    "grammar": "editorial"
  },
  "camera": {
    "mode": "cuts"
  },
  "ambient": {
    "level": "subtle"
  },
  "captions": {
    "preset": "minimal-line",
    "position": "auto",
    "lanes": {
      "footage-led": {
        "preset": "quiet-accent"
      }
    }
  },
  "sound": {
    "sfx_density": "low",
    "music": {
      "prompt_hints": [
        "sparse felt piano",
        "soft analogue pads",
        "no drums in the first bars"
      ],
      "bpm_range": [
        72,
        92
      ],
      "energy_curve": "slow-build"
    }
  },
  "modules": {
    "prefer": [
      "archive-card",
      "function-chart",
      "excerpt-window",
      "equation-lockup",
      "date-card",
      "masthead",
      "phone-stage",
      "backdrop-swap"
    ],
    "avoid": [
      "logo-row",
      "orbit-cards",
      "scrapbook",
      "doodle-outline"
    ],
    "params": {
      "checklist": {
        "presentation": "solid"
      },
      "callout": {
        "presentation": "solid"
      }
    }
  },
  "layout": {
    "title_case": false
  },
  "layouts": {
    "by_intent": {
      "list": "split-right",
      "quote": "framed",
      "proof": "framed"
    },
    "by_section": {
      "hook": "full"
    },
    "panel": {
      "treatment": "solid",
      "radius": 12
    }
  },
  "vocabulary": {
    "icon_tint": "primary",
    "illustration": false,
    "prefer": {
      "quote": [
        "excerpt-window"
      ],
      "number": [
        "count-up",
        "metric"
      ],
      "claim": [
        "kinetic-words"
      ]
    }
  },
  "cast": {
    "drawing_style": "flat",
    "colors": {
      "fill": "primary",
      "accent": "accent",
      "line": "paper"
    }
  },
  "brand_frame": {
    "enabled": true,
    "kicker": {
      "underline": true,
      "position": "top-left",
      "logo": true
    },
    "sections": true,
    "progress": false,
    "show": "always"
  },
  "dials": {
    "energy": 0.35,
    "density": 0.5,
    "playfulness": 0.2,
    "polish": 0.8
  },
  "loop": true
}
