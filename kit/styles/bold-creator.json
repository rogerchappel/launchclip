{
  "schema": "launchclip.style.v3",
  "name": "bold-creator",
  "description": "Creator-channel energy: black and white with hot yellow and pink, condensed caps, thick outlined captions, fast cuts and dense SFX.",
  "brand": {
    "colors": {
      "bg": "#0b0b0b",
      "paper": "#ffffff",
      "ink": "#0b0b0b",
      "primary": "#ffe14d",
      "accent": "#ff3d7f"
    },
    "fonts": {
      "display": "anton",
      "body": "archivo-black",
      "meta": "jetbrains-mono"
    }
  },
  "motion": {
    "grammar": "snappy"
  },
  "camera": {
    "mode": "cuts"
  },
  "ambient": {
    "level": "lively"
  },
  "captions": {
    "preset": "outline-heavy",
    "position": "auto",
    "lanes": {
      "footage-led": {
        "preset": "quiet-accent",
        "size": 1.08
      }
    }
  },
  "sound": {
    "sfx_density": "high",
    "music": {
      "prompt_hints": [
        "driving trap drums",
        "808 bass",
        "big drops on reveals"
      ],
      "bpm_range": [
        124,
        145
      ],
      "energy_curve": "hook-then-sustain"
    }
  },
  "modules": {
    "prefer": [
      "hook-title",
      "kinetic-words",
      "count-up",
      "cta",
      "emphasis-caption",
      "scrapbook",
      "orbit-cards",
      "doodle-outline"
    ],
    "avoid": [
      "excerpt-window",
      "archive-card"
    ],
    "params": {}
  },
  "layout": {
    "title_case": false
  },
  "layouts": {
    "by_intent": {
      "list": "split-right",
      "number": "insert",
      "product": "framed"
    },
    "by_section": {
      "hook": "full"
    },
    "panel": {
      "treatment": "solid",
      "radius": 32
    }
  },
  "vocabulary": {
    "icon_tint": "primary",
    "illustration": true,
    "prefer": {
      "claim": [
        "emphasis-caption",
        "kinetic-words"
      ],
      "number": [
        "count-up"
      ],
      "list": [
        "checklist"
      ]
    }
  },
  "cast": {
    "drawing_style": "outlined",
    "colors": {
      "fill": "primary",
      "accent": "accent",
      "line": "ink"
    }
  },
  "brand_frame": {
    "enabled": true,
    "kicker": {
      "underline": true,
      "position": "top-left",
      "logo": true
    },
    "sections": true,
    "progress": true,
    "show": "always"
  },
  "dials": {
    "energy": 0.85,
    "density": 0.7,
    "playfulness": 0.85,
    "polish": 0.4
  },
  "loop": true
}
