{
  "schema": "launchclip.style.v3",
  "name": "minimal-tech",
  "description": "Light, precise product explainers: off-white canvas, electric blue, grotesk type, glass panels, underline captions and smooth motion.",
  "brand": {
    "colors": {
      "bg": "#f4f5f7",
      "paper": "#0f1720",
      "ink": "#ffffff",
      "primary": "#2257e8",
      "accent": "#00866a"
    },
    "fonts": {
      "display": "space-grotesk",
      "body": "inter",
      "meta": "jetbrains-mono"
    }
  },
  "motion": {
    "grammar": "smooth"
  },
  "camera": {
    "mode": "world",
    "layout": "row"
  },
  "ambient": {
    "level": "subtle"
  },
  "captions": {
    "preset": "underline-sweep",
    "position": "auto",
    "shadow": false,
    "lanes": {
      "footage-led": {
        "preset": "quiet-accent"
      }
    }
  },
  "sound": {
    "sfx_density": "normal",
    "music": {
      "prompt_hints": [
        "minimal electronic",
        "clean plucks",
        "light four-on-the-floor"
      ],
      "bpm_range": [
        100,
        116
      ],
      "energy_curve": "steady"
    }
  },
  "modules": {
    "prefer": [
      "code-snippet",
      "status-rack",
      "process-steps",
      "trend-chart",
      "focus-flow",
      "masthead",
      "phone-stage",
      "backdrop-swap"
    ],
    "avoid": [
      "archive-card",
      "orbit-cards",
      "scrapbook",
      "doodle-outline"
    ],
    "params": {
      "checklist": {
        "presentation": "glass"
      },
      "status-rack": {
        "presentation": "glass"
      },
      "callout": {
        "presentation": "glass"
      },
      "focus-flow": {
        "presentation": "glass"
      }
    }
  },
  "layout": {
    "title_case": true
  },
  "layouts": {
    "by_intent": {
      "list": "split-right",
      "process": "split-right",
      "product": "framed"
    },
    "by_section": {
      "hook": "full"
    },
    "panel": {
      "treatment": "glass",
      "radius": 28
    }
  },
  "vocabulary": {
    "icon_tint": "primary",
    "illustration": true,
    "prefer": {
      "process": [
        "process-steps",
        "step-rail"
      ],
      "product": [
        "code-snippet",
        "excerpt-window"
      ],
      "number": [
        "metric",
        "trend-chart"
      ]
    }
  },
  "cast": {
    "drawing_style": "flat",
    "colors": {
      "fill": "primary",
      "accent": "accent",
      "line": "paper"
    }
  },
  "brand_frame": {
    "enabled": true,
    "kicker": {
      "underline": true,
      "position": "top-left",
      "logo": true
    },
    "sections": true,
    "progress": true,
    "show": "always"
  },
  "dials": {
    "energy": 0.5,
    "density": 0.55,
    "playfulness": 0.3,
    "polish": 0.75
  }
}
