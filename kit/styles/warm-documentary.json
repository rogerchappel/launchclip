{
  "schema": "launchclip.style.v3",
  "name": "warm-documentary",
  "description": "Archival documentary feel: warm umber canvas, cream serif type, a broadcast lower band for captions, slow pushes and restrained sound.",
  "brand": {
    "colors": {
      "bg": "#1c1612",
      "paper": "#f3e6d0",
      "ink": "#1c1612",
      "primary": "#e08a34",
      "accent": "#9cbf86"
    },
    "fonts": {
      "display": "instrument-serif",
      "body": "stix-two-text",
      "meta": "jetbrains-mono"
    }
  },
  "motion": {
    "grammar": "documentary"
  },
  "camera": {
    "mode": "cuts"
  },
  "ambient": {
    "level": "standard"
  },
  "captions": {
    "preset": "lower-band",
    "position": "auto",
    "lanes": {
      "footage-led": {
        "preset": "quiet-accent"
      }
    }
  },
  "sound": {
    "sfx_density": "low",
    "music": {
      "prompt_hints": [
        "warm acoustic guitar",
        "solo cello",
        "room tone"
      ],
      "bpm_range": [
        64,
        84
      ],
      "energy_curve": "arc"
    }
  },
  "modules": {
    "prefer": [
      "archive-card",
      "date-card",
      "excerpt-window",
      "media-window",
      "lower-third"
    ],
    "avoid": [
      "kinetic-words",
      "count-up",
      "masthead",
      "dolly-zoom",
      "feed-frame",
      "backdrop-swap",
      "app-stage",
      "phone-stage",
      "pull-back",
      "glass-word",
      "orbit-cards",
      "proof-wall",
      "scrapbook",
      "doodle-outline",
      "zoom-through"
    ],
    "params": {
      "date-card": {
        "presentation": "solid"
      }
    }
  },
  "layout": {
    "title_case": false
  },
  "layouts": {
    "by_intent": {
      "quote": "framed",
      "proof": "framed"
    },
    "by_section": {
      "hook": "full",
      "story": "full"
    },
    "panel": {
      "treatment": "paper",
      "radius": 6
    }
  },
  "vocabulary": {
    "icon_tint": "accent",
    "illustration": false,
    "prefer": {
      "quote": [
        "excerpt-window"
      ],
      "proof": [
        "archive-card",
        "date-card"
      ]
    }
  },
  "cast": {
    "drawing_style": "flat",
    "colors": {
      "fill": "primary",
      "accent": "accent",
      "line": "ink"
    }
  },
  "brand_frame": {
    "enabled": true,
    "kicker": {
      "underline": true,
      "position": "top-left",
      "logo": true
    },
    "sections": true,
    "progress": false,
    "show": "always"
  },
  "dials": {
    "energy": 0.25,
    "density": 0.4,
    "playfulness": 0.15,
    "polish": 0.7
  }
}
