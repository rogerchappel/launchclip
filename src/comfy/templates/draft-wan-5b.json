{
  "schema_version": "launchclip.comfy-template.v1",
  "id": "draft-wan-5b",
  "kind": "video",
  "description": "A short draft clip from a text prompt: Wan 2.2 TI2V-5B at about 480p and 24 fps, core ComfyUI nodes only.",
  "model": {
    "name": "Wan 2.2 TI2V-5B",
    "licence": "apache-2.0",
    "source": "https://huggingface.co/Wan-AI/Wan2.2-TI2V-5B",
    "files": [
      { "node": "UNETLoader", "input": "unet_name", "file": "wan2.2_ti2v_5B_fp16.safetensors" },
      { "node": "CLIPLoader", "input": "clip_name", "file": "umt5_xxl_fp8_e4m3fn_scaled.safetensors" },
      { "node": "VAELoader", "input": "vae_name", "file": "wan2.2_vae.safetensors" }
    ]
  },
  "inputs": {
    "prompt": "slow push in on an empty sunlit studio",
    "negative": "text, lettering, logo, watermark, subtitles, static, blurry, distorted, extra limbs",
    "width": 832,
    "height": 480,
    "frames": 73,
    "seed": 0,
    "steps": 20,
    "cfg": 5,
    "prefix": "launchclip/draft"
  },
  "output_nodes": ["11"],
  "workflow": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "wan2.2_vae.safetensors" } },
    "4": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": 8 } },
    "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
    "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{negative}}", "clip": ["2", 0] } },
    "7": { "class_type": "Wan22ImageToVideoLatent", "inputs": { "vae": ["3", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{frames}}", "batch_size": 1 } },
    "8": { "class_type": "KSampler", "inputs": { "model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1 } },
    "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["3", 0] } },
    "10": { "class_type": "CreateVideo", "inputs": { "images": ["9", 0], "fps": 24 } },
    "11": { "class_type": "SaveVideo", "inputs": { "video": ["10", 0], "filename_prefix": "{{prefix}}", "format": "auto", "codec": "auto" } }
  }
}
