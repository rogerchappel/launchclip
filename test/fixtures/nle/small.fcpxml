    <library>
        <event name="LaunchClip">
            <project name="small">
                <sequence format="r1" duration="6s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <asset-clip name="rec 1" ref="r3" offset="0s" duration="2s" start="0s" audioRole="dialogue">
                          <asset-clip name="finished render" ref="r7" lane="3" offset="0s" duration="6s" start="0s" enabled="0" srcEnable="video"/>
                          <asset-clip name="music bed" ref="r8" lane="-2" offset="0s" duration="6s" start="0s" audioRole="music">
                            <adjust-volume amount="-11.1dB"/>
                          </asset-clip>
                          <asset-clip name="finished mix (reference)" ref="r11" lane="-5" offset="0s" duration="6s" start="0s" enabled="0" audioRole="music"/>
                          <caption name="caption 1" lane="4" offset="3/10s" duration="9/10s" role="SRT?captionFormat=SRT.en">
                            <text placement="bottom"><text-style ref="ts1">Hello &amp; welcome</text-style></text>
                            <text-style-def id="ts1">
                              <text-style font=".AppleSystemUIFont" fontSize="13" fontFace="Regular" fontColor="1 1 1 1" backgroundColor="0 0 0 1"/>
                            </text-style-def>
                          </caption>
                          <asset-clip name="callout · footage-callout" ref="r5" lane="2" offset="1/2s" duration="2s" start="0s"/>
                          <asset-clip name="sfx-01-whoosh" ref="r9" lane="-3" offset="9/10s" duration="3/5s" start="0s" audioRole="effects">
