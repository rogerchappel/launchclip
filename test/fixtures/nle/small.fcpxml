                          </asset-clip>
                          <asset-clip name="sfx-02-tick" ref="r10" lane="-4" offset="1s" duration="2/15s" start="0s" audioRole="effects">
                            <adjust-volume amount="-10.5dB"/>
                          </asset-clip>
                          <caption name="caption 2" lane="4" offset="6/5s" duration="4/5s" role="SRT?captionFormat=SRT.en">
                            <text placement="bottom"><text-style ref="ts2">from &lt;LaunchClip&gt;</text-style></text>
                            <text-style-def id="ts2">
                              <text-style font=".AppleSystemUIFont" fontSize="13" fontFace="Regular" fontColor="1 1 1 1" backgroundColor="0 0 0 1"/>
                            </text-style-def>
                          </caption>
                          <marker start="1/2s" duration="1/30s" value="callout" note="scene callout · footage-callout · track 1"/>
                          <marker start="1s" duration="1/30s" value="cam" note="scene cam · punch-in · track 2"/>
                          <marker start="1s" duration="1/30s" value="cam: camera" note="camera punch-in ×1.1, 1–2s (not carried; re-create as a transform keyframe)"/>
                          <marker start="1s" duration="1/30s" value="callout: point" note="hit"/>
                        </asset-clip>
                        <asset-clip name="rec 2" ref="r3" offset="2s" duration="4s" start="3s" audioRole="dialogue">
                          <asset-clip name="insert · count-up" ref="r4" lane="1" offset="4s" duration="3/2s" start="0s"/>
                          <asset-clip name="tail · lower-third" ref="r6" lane="2" offset="5s" duration="2s" start="0s"/>
                          <caption name="caption 3" lane="4" offset="51/10s" duration="7/5s" role="SRT?captionFormat=SRT.en">
                            <text placement="bottom"><text-style ref="ts3">Try it</text-style></text>
                            <text-style-def id="ts3">
                              <text-style font=".AppleSystemUIFont" fontSize="13" fontFace="Regular" fontColor="1 1 1 1" backgroundColor="0 0 0 1"/>
                            </text-style-def>
                          </caption>
                          <asset-clip name="sfx-03-tick" ref="r10" lane="-3" offset="77/15s" duration="2/15s" start="0s" audioRole="effects">
                            <adjust-volume amount="-10.5dB"/>
                          </asset-clip>
                          <marker start="4s" duration="1/30s" value="insert" note="scene insert · count-up"/>
                          <marker start="9/2s" duration="1/30s" value="insert: hit" note="hit · cue impact"/>
                          <marker start="5s" duration="1/30s" value="tail" note="scene tail · lower-third · track 1"/>
                        </asset-clip>
                    </spine>
                </sequence>
            </project>
        </event>
