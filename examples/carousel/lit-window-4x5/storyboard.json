    {
      "id": "one-view",
      "module": "landscape-card",
      "start": 4,
      "end": 8,
      "energy": 1,
      "slide": {
        "role": "body",
        "medium": "still",
        "alt": "Every check in one view. Builds, reviews and rollouts, live.. over a photo"
      },
      "params": {
        "media": "assets/photos/dashboard.jpg",
        "title": "Every check in one view",
        "caption": "Builds, reviews and rollouts, live."
      }
    },
    {
      "id": "proof",
      "module": "stat-card",
      "start": 8,
      "end": 12,
      "energy": 1,
      "slide": {
        "role": "payoff",
        "medium": "still",
