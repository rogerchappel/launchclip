{
  "schema": "launchclip.story.v1",
  "title": "Every launch is a long climb (sample carousel, seams and panorama)",
  "notes": "Sample carousel for swipe continuity (docs/CAROUSELS_RFC.md §6.1): one panorama plate laid over slides 1-4, a moon across the first seam and a broken line across the last. The plate is generated by make-plate.mjs. Values are illustrative.",
  "lane": "motion",
  "format": {
    "kind": "carousel",
    "width": 1080,
    "height": 1350,
    "fps": 30,
    "duration": 20,
    "platform": "instagram"
  },
  "carousel": {
    "arc": "story",
    "goal": "save",
    "destinations": [
      "instagram",
      "linkedin"
    ],
    "caption": {
      "hook": "Nobody launches from the summit.",
      "body": "Four camps between an idea and a launch, and what each one asks of you.",
      "cta": "Save this for the next climb.",
      "tags": [
        "launch",
        "startups"
      ]
    },
    "panorama": {
      "src": "assets/panorama.jpg",
      "slides": [
        1,
        4
      ]
    },
    "seams": [
