        "after": "cover",
        "kind": "circle",
        "x": -0.07,
        "y": 0.5,
        "w": 0.14,
        "h": 0.112,
        "color": "accent"
      },
      {
        "after": "summit",
        "kind": "word",
        "text": "KEEP CLIMBING →",
        "x": -0.36,
        "y": 0.8,
        "w": 0.72,
        "h": 0.07,
        "color": "ink"
      },
      {
        "after": "summit",
        "kind": "rule",
        "x": -0.36,
        "y": 0.895,
        "w": 0.72,
        "h": 0.006,
        "color": "primary"
      }
    ]
  },
  "brand": {
    "colors": {
      "bg": "#0f1a24",
      "primary": "#e2552a",
      "accent": "#ffd166",
      "ink": "#f4efe6",
      "paper": "#f4efe6"
    },
    "fonts": {
      "display": "bricolage-grotesque",
      "body": "inter",
      "meta": "jetbrains-mono"
    }
  },
  "audio": null,
