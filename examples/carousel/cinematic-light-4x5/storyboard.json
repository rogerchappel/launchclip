{
  "schema": "launchclip.story.v1",
  "title": "cinematic-light (sample carousel template, instagram)",
  "lane": "motion",
  "format": {
    "kind": "carousel",
    "width": 1080,
    "height": 1350,
    "fps": 30,
    "duration": 20,
    "platform": "instagram"
