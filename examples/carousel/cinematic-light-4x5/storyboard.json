        "sleep"
      ]
    }
  },
  "background": {
    "kind": "flat"
  },
  "brand": {
    "colors": {
      "bg": "#ffffff",
      "primary": "#2f5d50",
      "accent": "#b8401f",
      "ink": "#ffffff",
      "paper": "#0c0d0e"
    },
    "fonts": {
      "display": "inter",
      "body": "dm-sans",
      "meta": "jetbrains-mono"
    },
    "name": "Calm Mornings",
    "palette": "as-given"
  },
