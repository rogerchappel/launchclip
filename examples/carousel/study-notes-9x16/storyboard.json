{
  "schema": "launchclip.story.v1",
  "title": "study-notes (sample carousel template, tiktok)",
  "lane": "motion",
  "format": {
    "kind": "carousel",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 24,
    "platform": "tiktok"
  },
  "carousel": {
    "arc": "listicle",
    "goal": "save",
    "destinations": [
      "tiktok"
    ],
    "template": "study-notes",
    "caption": {
      "hook": "Most teams are not slow. They wait.",
      "body": "Three habits that take the waiting out of a week.",
      "cta": "Save this for your next planning meeting.",
      "tags": [
        "productivity",
        "engineering",
        "teams"
      ]
    }
  },
  "plate": {
    "kind": "dot-field",
    "params": {
      "tint": "neutral"
    }
  },
  "brand": {
    "colors": {
      "bg": "#13151a",
      "primary": "#ffb020",
      "accent": "#ff6b5f",
      "ink": "#13151a",
      "paper": "#f5f1e8"
    },
    "fonts": {
      "display": "bricolage-grotesque",
      "body": "inter",
      "meta": "jetbrains-mono"
    }
  },
  "audio": null,
  "scenes": [
    {
      "id": "cover",
      "module": "hook-title",
      "plate": {
        "kind": "prism",
        "params": {
          "tint": "primary"
        }
      },
      "start": 0,
      "end": 4,
      "energy": 2,
      "slide": {
        "role": "cover",
        "medium": "still",
        "alt": "Field guide. 3 habits of teams that ship daily"
      },
      "params": {
        "headline": "3 habits of teams that ship daily",
        "emphasis": "ship daily",
        "eyebrow": "Field guide",
        "variant": "flush"
      }
    },
    {
      "id": "habit-1",
      "module": "motion-title",
      "start": 4,
      "end": 8,
      "energy": 1,
      "slide": {
        "role": "body",
        "medium": "still",
        "alt": "01. Decide in the thread. A written call travels further than a meeting."
      },
      "params": {
        "text": "Decide in the thread",
        "kicker": "01",
        "sub": "A written call travels further than a meeting.",
        "align": "left",
        "variant": "line-by-line-slide"
      }
    },
    {
      "id": "habit-2",
      "module": "motion-title",
      "start": 8,
      "end": 12,
      "energy": 1,
      "slide": {
        "role": "body",
        "medium": "still",
        "alt": "02. Ship the smallest change that works. Small diffs review fast and roll back clean."
      },
      "params": {
        "text": "Ship the smallest change that works",
        "kicker": "02",
        "sub": "Small diffs review fast and roll back clean.",
        "align": "left",
        "variant": "line-by-line-slide"
      }
    },
    {
      "id": "habit-3",
      "module": "motion-title",
      "start": 12,
      "end": 16,
      "energy": 1,
      "slide": {
        "role": "body",
        "medium": "still",
        "alt": "03. Review the same day. A day-old review costs a context switch."
      },
      "params": {
        "text": "Review the same day",
        "kicker": "03",
        "sub": "A day-old review costs a context switch.",
        "highlight": [
          "same",
          "day"
        ],
        "align": "left",
        "variant": "line-by-line-slide"
      }
    },
    {
      "id": "checklist",
      "module": "item-list",
      "start": 16,
      "end": 20,
      "energy": 1,
      "slide": {
        "role": "payoff",
        "medium": "still",
        "alt": "Save this checklist. Decide in the thread. Ship the smallest change. Review the same day"
      },
      "params": {
        "title": "Save this checklist",
        "items": [
          "Decide in the thread",
          "Ship the smallest change",
          "Review the same day"
        ],
        "variant": "stack",
        "ticks": true
      }
    },
    {
      "id": "cta",
      "module": "cta",
      "plate": {
        "kind": "prism",
        "params": {
          "tint": "primary"
        }
      },
      "start": 20,
      "end": 24,
      "energy": 2,
      "slide": {
        "role": "cta",
        "medium": "still",
        "alt": "Save it for your next sprint"
      },
      "params": {
        "action": "Save it for your next sprint",
        "emphasis": "Save",
        "handle": "fastteams.test",
        "variant": "flush"
      }
    }
  ],
  "notes": "Sample for a carousel template (docs/guide/carousels.md, Templates), written by scripts/carousel-template-samples.mjs. Figures, names and handles are illustrative. Photos are stand-ins already in the repo."
}
