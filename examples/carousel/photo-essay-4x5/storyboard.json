        "role": "cover",
        "medium": "still",
        "alt": "Photo essay. Three mornings on the ridge. over a photo"
      },
      "params": {
        "media": "assets/photos/ridge.jpg",
        "variant": "top",
        "share": 0.52,
        "fade": {
          "color": "ground",
          "stops": [
            0,
            0.22
          ],
          "opacity": 1
        },
        "kicker": "Photo essay →",
        "title": "Three mornings on the ridge",
        "align": "left"
      }
    },
    {
      "id": "first",
      "module": "split-screen",
      "start": 4,
      "end": 8,
      "energy": 1,
      "slide": {
        "role": "body",
        "medium": "still",
        "alt": "Day one. Fog until seven, then everything at once. The light arrives faster than you can set up.. over a photo"
      },
      "params": {
        "media": "assets/photos/ridge-sun.jpg",
        "variant": "top",
        "share": 0.45,
        "fade": {
          "color": "ground",
          "stops": [
            0,
            0.22
          ],
          "opacity": 1
        },
        "kicker": "Day one",
        "title": "Fog until seven, then everything at once",
        "align": "left",
        "body": "The light arrives faster than you can set up."
      }
    },
    {
      "id": "second",
      "module": "split-screen",
      "start": 8,
      "end": 12,
      "energy": 1,
      "slide": {
        "role": "body",
        "medium": "still",
        "alt": "Day two. The quiet before anyone else is up. Nothing to do but wait for the colour.. over a photo"
      },
      "params": {
        "media": "assets/photos/ridge-dusk.jpg",
        "variant": "top",
        "share": 0.45,
        "fade": {
          "color": "ground",
          "stops": [
            0,
            0.22
          ],
          "opacity": 1
        },
        "kicker": "Day two",
        "title": "The quiet before anyone else is up",
        "align": "left",
        "body": "Nothing to do but wait for the colour."
      }
    },
    {
      "id": "note",
      "module": "motion-title",
      "start": 12,
      "end": 16,
      "energy": 1,
      "slide": {
        "role": "payoff",
        "medium": "still",
        "alt": "What I learned. Get there an hour early. The best frame is never the one you planned."
