{
  "schema": "launchclip.story.v1",
  "title": "photo-essay (sample carousel template, instagram)",
  "lane": "motion",
  "format": {
    "kind": "carousel",
    "width": 1080,
    "height": 1350,
    "fps": 30,
    "duration": 20,
    "platform": "instagram"
  },
  "carousel": {
    "arc": "story",
    "goal": "follow",
    "destinations": [
      "instagram"
    ],
    "template": "photo-essay",
    "caption": {
      "hook": "Three mornings on the ridge.",
      "body": "A small project about getting up early.",
      "cta": "Follow for the rest of the series.",
      "tags": [
        "photography",
        "outdoors"
      ]
    }
  },
  "background": {
    "kind": "flat"
  },
  "brand": {
    "colors": {
      "bg": "#f5f2ea",
      "primary": "#ad5639",
      "accent": "#2f5d50",
      "ink": "#f5f2ea",
      "paper": "#202020"
    },
    "fonts": {
      "display": "fraunces",
      "body": "dm-sans",
      "meta": "jetbrains-mono"
    },
    "palette": "as-given"
  },
  "audio": null,
  "scenes": [
    {
      "id": "cover",
      "module": "split-screen",
      "start": 0,
      "end": 4,
      "energy": 2,
