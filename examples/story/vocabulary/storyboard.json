{
  "schema": "launchclip.story.v1",
  "title": "Vocabulary example: catalogue G cards over a recording and as inserts (scenes overlap on purpose: parity renders one at a time)",
  "lane": "footage-led",
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 22,
    "platform": "youtube-shorts"
  },
  "brand": {
    "colors": {
      "bg": "#06070d",
      "primary": "#fdb022",
      "accent": "#46d4ff",
      "ink": "#06070d",
      "paper": "#f2eee6"
    },
    "fonts": {
      "display": "anton",
      "body": "space-grotesk",
      "meta": "jetbrains-mono"
    }
  },
  "base": {
    "src": "assets/recording.mp4",
    "fit": "cover",
    "focus": {
      "x": 0.5,
      "y": 0.36
    },
    "volume": 0
  },
  "scenes": [
    {
      "id": "concept",
      "module": "concept-card",
      "track": 1,
      "start": 0.5,
      "end": 3.5,
      "params": {
        "text": "Ship faster",
        "icon": "rocket",
        "sub": "From recording to Short"
      }
    },
    {
      "id": "row",
      "module": "icon-row",
      "track": 1,
      "start": 3.6,
      "end": 7,
      "params": {
        "title": "Three steps",
        "items": [
          {
            "icon": "mic",
            "label": "Record"
          },
          {
            "icon": "scissors",
            "label": "Cut"
          },
          {
            "icon": "send",
            "label": "Post"
          }
        ]
      }
    },
    {
      "id": "section",
      "module": "section-card",
      "insert": true,
      "start": 7,
      "end": 9.5,
      "in": {
        "type": "fade",
        "dur": 0.3
      },
      "params": {
        "title": "How it works",
        "kicker": "Part two",
        "number": 2
      }
    },
    {
      "id": "object",
      "module": "object-card",
      "track": 1,
      "start": 9.6,
      "end": 13,
      "params": {
        "object": "box",
        "caption": "It ships as one file",
        "label": "Export"
      }
    },
    {
      "id": "object-insert",
      "module": "object-card",
      "insert": true,
      "start": 13.2,
      "end": 16,
      "in": {
        "type": "fade",
        "dur": 0.3
      },
      "params": {
        "object": "boat",
        "caption": "Launch day, sorted",
        "label": "Release"
      }
    },
    {
      "id": "row-insert",
      "module": "icon-row",
      "insert": true,
      "start": 16,
      "end": 18,
      "params": {
        "title": "Works with",
        "items": [
          {
            "icon": "code",
            "label": "Your repo"
          },
          {
            "icon": "video",
            "label": "Your clips"
          },
          {
            "icon": "palette",
            "label": "Your brand"
          },
          {
            "icon": "globe",
            "label": "Every feed"
          }
        ]
      }
    },
    {
      "id": "concept-insert",
      "module": "concept-card",
      "insert": true,
      "start": 18,
      "end": 20,
      "params": {
        "text": "Security first",
        "icon": "shield-check",
        "sub": "Signed, checked, shipped",
        "tone": "primary"
      }
    },
    {
      "id": "stat",
      "module": "stat-card",
      "track": 2,
      "start": 0.5,
      "end": 4,
      "params": {
        "value": "12 min",
        "label": "from recording to finished Short",
        "source": "LaunchClip example timing log",
        "icon": "timer"
      }
    },
    {
      "id": "stat-insert",
      "module": "stat-card",
      "insert": true,
      "start": 0.5,
      "end": 3.5,
      "in": {
        "type": "fade",
        "dur": 0.3
      },
      "params": {
        "value": "87%",
        "label": "of edits ship the same day",
        "source": "Example usage log, Oct 2026"
      }
    },
    {
      "id": "quote-insert",
      "module": "quote-card",
      "insert": true,
      "start": 3.6,
      "end": 6.9,
      "in": {
        "type": "fade",
        "dur": 0.3
      },
      "params": {
        "quote": "It turned a four-hour edit into a coffee break.",
        "author": "Ada Park",
        "role": "Founder, LaunchClip",
        "highlight": "a coffee break"
      }
    },
    {
      "id": "excerpt-insert",
      "module": "excerpt",
      "insert": true,
      "start": 9.6,
      "end": 13,
      "in": {
        "type": "fade",
        "dur": 0.3
      },
      "params": {
        "type": "code",
        "title": "package.json",
        "source": "examples/story/vocabulary",
        "lines": [
          "\"scripts\": {",
          {
            "text": "  \"video\": \"launchclip make\",",
            "highlight": true
          },
          "}"
        ]
      }
    },
    {
      "id": "timeline",
      "module": "timeline",
      "track": 3,
      "start": 13.2,
      "end": 17,
      "params": {
        "direction": "horizontal",
        "steps": [
          {
            "label": "Record",
            "icon": "mic"
          },
          {
            "label": "Cut",
            "icon": "scissors"
          },
          {
            "label": "Post",
            "icon": "send"
          }
        ]
      }
    },
    {
      "id": "compare-insert",
      "module": "compare",
      "insert": true,
      "start": 20,
      "end": 22,
      "in": {
        "type": "fade",
        "dur": 0.3
      },
      "params": {
        "stagger": 0.12,
        "left": {
          "title": "Before",
          "items": [
            "A week in the editor",
            "Captions by hand"
          ]
        },
        "right": {
          "title": "After",
          "items": [
            "Twelve minutes",
            "Captions from the transcript"
          ]
        }
      }
    }
  ]
}
