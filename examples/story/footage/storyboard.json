{
  "schema": "launchclip.story.v1",
  "title": "Footage-led example: one recording, edited and dressed",
  "lane": "footage-led",
  "format": { "width": 1080, "height": 1920, "fps": 30, "duration": 20, "platform": "youtube-shorts" },
  "brand": {
    "colors": { "bg": "#06070d", "primary": "#fdb022", "accent": "#46d4ff", "ink": "#06070d", "paper": "#f2eee6" },
    "fonts": { "display": "anton", "body": "space-grotesk", "meta": "jetbrains-mono" }
  },
  "audio": { "words": "NARRATION.json" },
  "base": {
    "src": "assets/recording.mp4",
    "edl": "recording/edit-plan.json",
    "fit": "cover",
    "focus": { "x": 0.5, "y": 0.36 },
    "volume": 1
  },
  "scenes": [
    {
      "id": "hook",
      "module": "emphasis-caption",
      "track": 1,
      "start": 0.2,
      "end": 2.4,
      "params": { "text": "Buried demos", "at": 0 },
      "hits": [{ "at": "word:most", "event": "pop" }]
    },
    {
      "id": "punch-demo",
      "module": "punch-in",
      "track": 2,
      "start": 1.6,
      "end": 2.9,
      "params": { "scale": 1.14 },
      "hits": [{ "at": "word:demo", "event": "punch" }]
    },
    {
      "id": "builder",
      "module": "footage-callout",
      "track": 1,
      "start": 2.9,
      "end": 5.6,
      "params": { "text": "The person who built it", "label": "On camera", "point": { "x": 0.56, "y": 0.36 }, "side": "above" },
      "hits": [{ "at": "word:person", "event": "point" }]
    },
    {
      "id": "name",
      "module": "lower-third",
      "track": 1,
      "start": 5.8,
      "end": 8.9,
      "params": { "name": "Ada Park", "title": "Founder, LaunchClip" },
      "hits": [{ "at": "word:ada", "event": "name" }]
    },
    {
      "id": "punch-recording",
      "module": "punch-in",
      "track": 2,
      "start": 8.9,
      "end": 10.9,
      "params": { "scale": 1.1, "release": 0.5 },
      "hits": [{ "at": "word:recording", "event": "punch" }]
    },
    {
      "id": "twelve",
      "module": "count-up",
      "insert": true,
      "start": 11.0,
      "end": 14.2,
      "in": { "type": "fade", "dur": 0.3 },
      "params": { "value": 12, "suffix": " min", "label": "from recording to finished Short", "note": "Illustrative timing", "hit": "both", "countAt": 0.3, "countDuration": 0.9 },
      "hits": [{ "at": "word:twelve", "event": "hit" }]
    },
    {
      "id": "captions-note",
      "module": "footage-callout",
      "track": 1,
      "start": 14.4,
      "end": 17.9,
      "params": { "text": "Straight from the transcript", "label": "Generated", "point": { "x": 0.72, "y": 0.6 }, "tone": "dark", "tilt": 2 },
      "hits": [{ "at": "word:captions", "event": "point" }]
    },
    {
      "id": "punch-callouts",
      "module": "punch-in",
      "track": 2,
      "start": 15.6,
      "end": 17.1,
      "params": { "scale": 1.08 },
      "hits": [{ "at": "word:callouts", "event": "punch" }]
    },
    {
      "id": "try-it",
      "module": "emphasis-caption",
      "track": 1,
      "start": 18.1,
      "end": 20,
      "params": { "text": "Try it" },
      "hits": [{ "at": "word:try", "event": "pop" }]
    }
  ],
  "overlays": [{ "type": "captions", "style": "word-highlight" }]
}
