{
  "schema": "launchclip.story.v1",
  "title": "Subject stage example: product moments around the presenter",
  "lane": "footage-led",
  "format": { "width": 1080, "height": 1920, "fps": 30, "duration": 12, "platform": "youtube-shorts" },
  "brand": {
    "colors": { "bg": "#06070d", "primary": "#fdb022", "accent": "#46d4ff", "ink": "#06070d", "paper": "#f2eee6" },
    "fonts": { "display": "anton", "body": "space-grotesk", "meta": "jetbrains-mono" }
  },
  "base": {
    "src": "assets/recording.mp4",
    "fit": "cover",
    "volume": 0,
    "subject": {
      "mattes": [{ "src": "assets/subject/0.000-12.000.webm", "in": 0, "out": 12, "info": "assets/subject/0.000-12.000.json", "plate": "assets/subject/0.000-12.000.plate.jpg" }]
    }
  },
  "scenes": [
    { "id": "feed", "module": "feed-frame", "track": 1, "start": 0.3, "end": 2.5, "params": { "handle": "@ada", "caption": "Built in a weekend", "counts": { "likes": "1.2K" } } },
    { "id": "app", "module": "app-stage", "track": 1, "start": 2.7, "end": 4.7, "params": { "media": { "src": "assets/app.png" }, "title": "Ledgerly" } },
    { "id": "swap", "module": "backdrop-swap", "track": 1, "start": 4.9, "end": 6.9, "params": { "title": "Meet Ledgerly" } },
    { "id": "phone", "module": "phone-stage", "track": 2, "start": 7, "end": 9, "params": { "media": { "src": "assets/demo/flow.mp4" } } },
    { "id": "pull", "module": "pull-back", "track": 1, "start": 9, "end": 12, "params": { "steps": ["Transcribe", "Cut", "Caption"], "title": "launch.mp4" } }
  ]
}
