              },
              {
                "kind": "window",
                "props": {
                  "title": "plan.json"
                }
              },
              {
                "kind": "window",
                "props": {
                  "title": "render.log"
                }
              },
              {
                "kind": "window",
                "props": {
                  "title": "captions"
                }
              },
              {
                "kind": "window",
                "props": {
                  "title": "sound"
                }
              }
            ]
          },
          {
            "kind": "burst",
            "at": "word:lock",
            "props": {
              "target": "gauge",
              "rays": 14
            },
            "cue": "impact"
          }
        ]
      }
    },
    {
      "id": "s3",
      "module": "ui-scene",
      "start": 7.2,
      "end": 9.6,
      "in": {
        "type": "push-blur",
        "dur": 0.5
