      "params": {
        "elements": [
          {
            "kind": "headline",
            "rect": {
              "x": 80,
              "y": 280,
              "width": 860,
              "height": 210
            },
            "at": 0,
            "enter": "cut",
            "props": {
              "lines": [
                {
                  "text": "NO TIMELINE.",
                  "size": "s"
                },
                {
                  "text": "*JUST* SHIP.",
                  "size": "l"
                }
              ]
            }
          },
          {
            "kind": "stack",
            "arrange": "fan",
            "rect": {
              "x": 40,
              "y": 560,
              "width": 1000,
              "height": 890
            },
            "at": 0,
            "enter": "cut",
            "children": [
              {
                "kind": "terminal",
                "props": {
                  "title": "launchclip",
                  "sub": "ship",
                  "prompt": "publish final.mp4",
                  "typeAt": 0.1,
                  "cps": 40
                }
              },
              {
                "kind": "meter",
                "props": {
                  "title": "LOUDNESS",
                  "from": -31,
                  "to": -14,
                  "settleAt": 0.8
                }
              },
              {
                "kind": "window",
                "props": {
                  "title": "final.mp4"
                }
              }
            ]
          }
