{
  "schema": "launchclip.story.v1",
  "title": "Minimal dual-renderer story",
  "lane": "motion",
  "format": { "width": 1080, "height": 1920, "fps": 30, "duration": 6, "platform": "youtube-shorts" },
  "brand": {
    "colors": { "bg": "#06070d", "primary": "#fdb022", "accent": "#46d4ff", "ink": "#06070d", "paper": "#f2eee6" },
    "fonts": { "display": "anton", "body": "space-grotesk", "meta": "jetbrains-mono" }
  },
  "audio": { "words": "NARRATION.json", "mix": "assets/audio/mix.wav" },
  "scenes": [
    {
      "id": "s1",
      "module": "metric",
      "start": 0,
      "end": 3,
      "energy": 1,
      "params": {
        "title": "Build time",
        "rect": { "x": 90, "y": 380, "width": 840, "height": 620 },
        "metric": {
          "mode": "illustration",
          "unit": "example minutes",
          "format": "number",
          "decimals": 0,
          "values": [{ "value": 48, "at": 0.4 }, { "value": 12, "at": 1.6 }]
        }
      },
      "hits": [{ "at": "word:twelve", "event": "settle", "cue": "tick" }]
    },
    {
      "id": "s2",
      "module": "checklist",
      "start": 3,
      "end": 6,
      "energy": 2,
      "in": { "type": "fade", "dur": 0.4 },
      "params": {
        "title": "Three changes",
        "rect": { "x": 90, "y": 380, "width": 840, "height": 620 },
        "statusLabels": { "pending": "Next", "active": "Now", "done": "Done" },
        "rows": [
          { "label": "Cache dependencies", "status": "done", "at": 0.5 },
          { "label": "Split the test suite", "status": "done", "at": 1.1 },
          { "label": "Ship smaller images", "status": "done", "at": 1.7 }
        ]
      },
      "hits": [{ "at": "word:three", "event": "rows-start" }]
    }
  ],
  "overlays": [{ "type": "captions", "style": "word-highlight" }],
  "ending": { "loop_to": "s1" }
}
